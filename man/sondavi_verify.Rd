\item{\code{"malformed"}}{The certificate file is not a certificate of a supported version.}
\item{\code{"untrusted_issuer"}}{It was issued by an installation not in \code{trust}.}
\item{\code{"unknown_key"}}{The issuer's published keys do not include the one it names.}
\item{\code{"invalid_signature"}}{The certificate itself was altered after it was issued.}
\item{\code{"unverifiable"}}{The file does not have the structure the certificate
describes: a certified column is missing without being listed as removed,
the number of rows does not match, a row has more or fewer fields than
the header, or it is not a well-formed CSV file.}
\item{\code{"modified"}}{The certificate is genuine, but cells differ from what was certified.}
\item{\code{"valid"}}{Every certified cell matches.}
